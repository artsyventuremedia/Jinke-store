# Copy to .env and fill in. Never commit .env.

# Your domain, without https:// (used by Caddy for the HTTPS certificate)
DOMAIN=yourstore.in
# Full public address of the store (used in emails, sitemap and link previews)
PUBLIC_URL=https://yourstore.in

# First admin account, created on the very first start only.
# If ADMIN_PASSWORD is empty, a random password is printed once in the logs.
ADMIN_EMAIL=jinke.wear@gmail.com
ADMIN_PASSWORD=

# production = no demo data and no default password on first start
NODE_ENV=production
# Set to true to load the demo catalogue on first start anyway
SEED_DEMO=false

# Optional
# PORT=3000
# DB_PATH=./data/store.db
# UPLOADS_DIR=./uploads
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=14
# Time zone for dashboard days, invoice dates and the financial year (default Asia/Kolkata)
# STORE_TZ=Asia/Kolkata

# --- Vercel only (leave empty elsewhere: the store then uses a local database file) ---
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=...
# BLOB_READ_WRITE_TOKEN=...      # set automatically when you connect Vercel Blob
# CRON_SECRET=any-long-random-text
